# Copiar para .env na raiz do monorepo
PORT=3000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# Fonte dos elencos: classpath (arquivos em output/data/elencos/) ou s3
ELENCOS_SOURCE=classpath

# Necessário somente com ELENCOS_SOURCE=s3
# S3_BUCKET=janela-galo
# AWS_REGION=sa-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
